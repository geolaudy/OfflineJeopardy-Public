{
  "name": "offline-jeopardy",
  "productName": "OfflineJeopardy",
  "version": "0.17.0-rc.1",
  "private": true,
  "description": "Fully offline, customizable Jeopardy-style game for Windows with LAN host controller and buzzers.",
  "type": "module",
  "main": "dist/electron/main.cjs",
  "author": "geolaudy",
  "license": "UNLICENSED",
  "devDependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-bold": "3.31.4",
    "@tiptap/extension-document": "3.31.4",
    "@tiptap/extension-hard-break": "3.31.4",
    "@tiptap/extension-italic": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-text": "3.31.4",
    "@tiptap/extension-underline": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.44.0",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.5",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/cli.ts --data=data --sfx=new_sfx --dev-tools",
    "dev:web": "vite",
    "serve": "tsx src/server/cli.ts",
    "build:web": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:web && npm run build:electron",
    "start": "npm run build && electron .",
    "app": "electron .",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "dist": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:verify": "node scripts/verify-dist.mjs",
    "release:local": "npm run typecheck && npm test && npm run dist && npm run dist:verify",
    "dist:dir": "npm run build && electron-builder --win dir",
    "dev:lock:status": "node scripts/dev-lock.mjs status",
    "dev:lock:acquire": "node scripts/dev-lock.mjs acquire",
    "dev:lock:release": "node scripts/dev-lock.mjs release",
    "dev:lock:recover": "node scripts/dev-lock.mjs recover",
    "dev:lock:check": "node scripts/dev-lock.mjs check",
    "dev:lock:task": "node scripts/dev-lock.mjs task"
  },
  "build": {
    "appId": "app.offlinejeopardy.desktop",
    "productName": "OfflineJeopardy",
    "copyright": "OfflineJeopardy",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/**/*.map"
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "extraResources": [
      {
        "from": "docs/USER_GUIDE.md",
        "to": "USER_GUIDE.md"
      },
      {
        "from": "build/private-sfx",
        "to": "soundpacks/buzzinga",
        "filter": [
          "*.mp3",
          "*.wav",
          "*.ogg",
          "*.m4a"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}",
      "useZip": true,
      "splashImage": "build/portable-splash.bmp"
    }
  }
}
